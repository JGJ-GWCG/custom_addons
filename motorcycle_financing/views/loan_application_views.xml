Loan application views · XML
<odoo>
    <record id="loan_record" model="ir.actions.act_window">
        <field name="name">Loan Applications</field>
        <field name="res_model">loan.application</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="loan_application_form_view" model="ir.ui.view">
        <field name="name">loan.application.form</field>
        <field name="model">loan.application</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send" string="Send" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_review" string="Start Credit Check" type="object" invisible="state != 'sent'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'review'"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state != 'review'"/>
                    <button name="action_sign" string="Mark as Signed" type="object" class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('signed', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,review,approved,signed"/>
                </header>
                <sheet>
                    <!--
                        Smart buttons: patrón nativo de Odoo para navegar a
                        registros relacionados sin ocupar espacio permanente
                        en el formulario. widget="statinfo" muestra el número
                        grande arriba y la etiqueta abajo, estilo contador.
                    -->
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_documents" icon="fa-file-text-o">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_documents_approved" icon="fa-check-circle">
                            <field name="document_count_approved" widget="statinfo" string="Approved"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    </div>
                    <group>
                        <!--
                            Application Info: el "quién/qué" del préstamo.
                            Ninguno de estos campos aparecía antes en el form,
                            así que hasta ahora era imposible ver el cliente,
                            la orden de venta o el vendedor desde esta pantalla.
                        -->
                        <group string="Application Info">
                            <field name="partner_id"/>
                            <field name="sale_order_id"/>
                            <field name="user_id"/>
                            <field name="product_template_id"/>
                        </group>
                        <group string="Loan Info">
                            <field name="sale_order_total"/>
                            <field name="down_payment"/>
                            <field name="loan_amount"/>
                            <field name="currency_id" groups="base.group_multi_currency" options="{'no_create': True}"/>
                            <field name="interest_rate"/>
                            <field name="loan_term"/>
                        </group>
                    </group>
                    <group>
                        <group string="Date Log">
                            <field name="date_application"/>
                            <field name="date_approval"/>
                            <field name="date_rejection"/>
                            <field name="date_signed"/>
                        </group>
                    </group>
                    <notebook>
                        <!--
                            Referencia "pelona" al one2many (sin arch propio
                            aquí adentro): Odoo reutiliza automáticamente la
                            vista loan_application_document_list_view para
                            renderizarlo, incluyendo su editable="bottom" y
                            el badge del estado. Así solo hay un lugar donde
                            mantener esa definición en vez de duplicarla.
                        -->
                        <page string="Documentation" name="documentation">
                            <field name="document_ids"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                        <page string="Rejection Details" name="rejection_details" invisible="state != 'rejected'">
                            <field name="rejection_reason"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="loan_application_list_view" model="ir.ui.view">
        <field name="name">loan.application.list</field>
        <field name="model">loan.application</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'rejected'" decoration-success="state == 'approved'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_application"/>
                <field name="loan_amount"/>
                <field name="interest_rate"/>
                <field name="loan_term"/>
                <field name="state"/>
            </list>
        </field>
    </record>
</odoo>
 