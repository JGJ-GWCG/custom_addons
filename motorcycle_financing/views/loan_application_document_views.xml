<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="loan_application_document_list_view" model="ir.ui.view">
        <field name="name">loan.application.document.list</field>
        <field name="model">loan.application.document</field>
        <field name="arch" type="xml">
            <!--
                editable="bottom": esta misma vista se usa tanto para el menú
                standalone de Documents como para la lista incrustada dentro
                del notebook de loan.application (cuando se referencia el
                campo document_ids sin arch propio, Odoo reutiliza esta
                vista) — con editable="bottom" queda editable en ambos
                lugares sin duplicar la definición dos veces.
            -->
            <list decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" editable="bottom">
                <field name="name"/>
                <!--
                    application_id se deja declarado normal: cuando esta
                    misma vista se reutiliza dentro del notebook de
                    loan.application (como document_ids), Odoo oculta
                    automáticamente la columna que apunta de vuelta al padre
                    — es comportamiento nativo, no requiere ninguna condición
                    manual. Sigue visible cuando se navega a Documents desde
                    su propio menú, donde sí hace falta ver a qué aplicación
                    pertenece cada documento.
                -->
                <field name="application_id"/>
                <!--
                    Un campo Binary en una lista ya se muestra nativamente
                    como enlace de descarga + tamaño del archivo (el "8.69 Kb"
                    de la captura) — no hace falta ningún widget especial,
                    solo declarar el campo con su filename asociado.
                -->
                <field name="attachment" filename="attachment_filename"/>
                <field name="attachment_filename" column_invisible="1"/>
                <field name="type_id"/>
                <!--
                    widget="badge": el widget nativo de Odoo para mostrar un
                    Selection como pastilla de color en vez de texto plano.
                    Los decoration-* controlan qué color usa cada valor,
                    igual que el patrón que ya usamos en el propio list de
                    loan.application (decoration-success/decoration-danger).
                -->
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-info="state == 'new'"/>
            </list>
        </field>
    </record>
 
    <record id="loan_application_document_form_view" model="ir.ui.view">
        <field name="name">loan.application.document.form</field>
        <field name="model">loan.application.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="new,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Application Info">
                            <field name="application_id"/>
                            <field name="type_id"/>
                        </group>
                        <group string="File">
                            <field name="attachment" filename="attachment_filename"/>
                            <field name="attachment_filename" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
 
    <record id="loan_application_document_search_view" model="ir.ui.view">
        <field name="name">loan.application.document.search</field>
        <field name="model">loan.application.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="application_id"/>
                <field name="type_id"/>
            </search>
        </field>
    </record>
 
    <record id="loan_application_document_action" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">loan.application.document</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
 