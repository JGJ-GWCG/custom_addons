<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="loan_application_document_type_list_view" model="ir.ui.view">
        <field name="name">loan.application.document.type.list</field>
        <field name="model">loan.application.document.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="document_number"/>
            </list>
        </field>
    </record>

    <record id="loan_application_document_type_form_view" model="ir.ui.view">
        <field name="name">loan.application.document.type.form</field>
        <field name="model">loan.application.document.type</field>
        <field name="arch" type="xml">
            <form>
                <!--
                    No agregamos botones ni el campo "active" aquí a propósito:
                    Odoo detecta que el modelo tiene un campo Boolean llamado
                    "active" y automáticamente agrega "Archive"/"Unarchive" al
                    menú de acciones (⚙) de la lista y del formulario, además
                    de un filtro "Archived" en el buscador. No hace falta
                    programar ni declarar nada extra para eso.
                -->
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="document_number"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="loan_application_document_type_search_view" model="ir.ui.view">
        <field name="name">loan.application.document.type.search</field>
        <field name="model">loan.application.document.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="loan_application_document_type_action" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">loan.application.document.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>